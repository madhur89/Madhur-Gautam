{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "SHOP NOW →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Bar Text",
      "default": "Free shipping on orders over $50!"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner",
      "category": "Banner"
    }
  ]
}
{% endschema %}

<section class="custom-banner">
  <div class="banner-wrapper" 
    {% if section.settings.background_image %} 
      style="background-image: url({{ section.settings.background_image | img_url: '1800x' }});" 
    {% endif %}>
    
    <div class="banner-content">
      <h2>{{ section.settings.heading }}</h2>
      <div class="banner-subheading">
        {{ section.settings.subheading }}
      </div>
      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        <a href="{{ section.settings.button_link }}" class="banner-btn">
          <span>{{ section.settings.button_label }}</span>
        </a>
      {% endif %}
    </div>

    {% if section.settings.announcement_text != blank %}
      <div class="banner-announcement">
        <p>{{ section.settings.announcement_text }}</p>
      </div>
    {% endif %}
  </div>
</section>

<style>
.custom-banner {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.banner-wrapper {
  background-size: cover;
  background-position: center;
  padding: 60px 20px;
  display: flex;
  justify-content: flex-start;
  align-items: center;
  min-height: 400px;
  flex-direction: column;
  position: relative;
}

.banner-content {
  max-width: 600px;
  padding-top: 15%;
  background: rgb(255 255 255 / 52%);
  border-radius: 6px;
}

.banner-content h2 {
  font-size: 2.5rem;
  margin-bottom: 15px;
  font-weight: bold;
}
.banner-subheading {
  font-size: 2rem;
  margin-bottom: 20px;
}

/* Button with gradient hover */
.banner-btn {
  position: relative;
  display: inline-block;
  padding: 12px 24px;
  background: linear-gradient(90deg, #ffeb3b, #ffc107);
  color: #000;
  font-weight: bold;
  text-decoration: none;
  border-radius: 4px;
  overflow: hidden;
  transition: color 0.3s ease;
  z-index: 1;
}

.banner-btn::before {
  content: "";
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, #000, #444);
  transition: left 0.5s ease;
  z-index: 0;
}

.banner-btn span {
  position: relative;
  z-index: 2;
}

.banner-btn:hover::before {
  left: 0;
}

.banner-btn:hover span {
  color: #fff;
}

/* Announcement Bar */
.banner-announcement {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  background: rgba(0,0,0,0.8);
  color: #fff;
  text-align: center;
  padding: 12px 20px;
  font-size: 1rem;
  font-weight: 500;
}

/* Responsive */
@media (max-width: 768px) {
  .banner-content h2 {
    font-size: 1.8rem;
  }
  .banner-content {
    max-width: 100%;
    padding: 15px;
  }
  .banner-subheading {
    font-size: 1.2rem;
  }
  .banner-announcement {
    font-size: 0.9rem;
  }
}
</style>
