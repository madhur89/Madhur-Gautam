{% schema %}
{
  "name": "Announcement Barcustom",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Text",
      "default": "Free shipping on orders over $50!"
    }
  ],
  "presets": [
    {
      "name": "Announcement Custom",
      "category": "Text"
    }
  ]
}
{% endschema %}

<section class="announcement-bar">
  <p>{{ section.settings.announcement_text }}</p>
</section>

<style>
.announcement-bar {
  width: 100%;
  background: #F5F5F5;
  color: Black;
  text-align: center;
  padding: 0px 20px;
  font-size: 1.2rem;
  font-weight: 500;
}

/* Responsive */
@media (max-width: 768px) {
  .announcement-bar {
    font-size: 0.9rem;
    padding: 10px 15px;
  }
}
</style>
