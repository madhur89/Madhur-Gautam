{% schema %}
{
  "name": "Product Grid + Quick View",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "default": 6,
      "min": 2,
      "max": 24,
      "step": 1
    },
    {
      "type": "product",
      "id": "bonus_product",
      "label": "Bonus product (auto-add when Black + Medium chosen)",
      "info": "Select “Soft Winter Jacket”."
    }
  ],
  "presets": [
    { "name": "Product Grid • Hotspots + Quick View", "category": "Collection" }
  ]
}
{% endschema %}

{% assign coll = collections[section.settings.collection] %}

<!-- ✅ Quick View Modal -->
<div id="quick-view-modal" class="quick-view-modal">
  <div class="quick-view-content">
    <button class="quick-view-close">&times;</button>
    <div class="quick-view-header">
      <img id="quick-view-image" src="" alt="" class="quick-view-image"/>
      <div class="quick-view-info">
        <h2 id="quick-view-title"></h2>
        <p id="quick-view-price"></p>
        <p id="quick-view-description"></p>
      </div>
    </div>
    <div id="quick-view-options" class="quick-view-options"></div>
    <p id="bonus-message" class="bonus-message" style="display:none;">
      🎁 Bonus: <strong>Soft Winter Jacket</strong> will be added automatically
    </p>
    <button id="quick-view-add" class="quick-view-add" disabled>
      ADD TO CART →
    </button>
  </div>
</div>

<style>
/* ✅ Modal Styles */
.quick-view-modal {
  display: none;
  position: fixed;
  z-index: 9999;
  left: 0; top: 0;
  width: 100%; height: 100%;
  background: rgba(0,0,0,0.6);
  justify-content: center;
  align-items: center;
}

.quick-view-content {
  background: #fff;
  padding: 20px;
  max-width: 420px;
  width: 95%;
  border-radius: 6px;
  position: relative;
  font-family: Arial, sans-serif;
}

.quick-view-close {
  position: absolute;
  right: 15px; top: 15px;
  border: none;
  background: none;
  font-size: 22px;
  cursor: pointer;
}

.quick-view-header {
  display: flex;
  gap: 15px;
  align-items: flex-start;
  margin-bottom: 15px;
}

.quick-view-image {
  width: 100px;
  height: auto;
  border-radius: 4px;
}

.quick-view-info h2 {
  margin: 0;
  font-size: 18px;
}

.quick-view-info p {
  margin: 5px 0;
  font-size: 14px;
  color: #444;
}

.quick-view-option {
  margin-bottom: 12px;
}

.quick-view-option label {
  font-weight: bold;
  font-size: 14px;
  margin-bottom: 5px;
  display: block;
}

.quick-view-option select {
  width: 100%;
  padding: 8px;
  font-size: 14px;
  border: 1px solid #ddd;
  border-radius: 4px;
}

.quick-view-add {
  width: 100%;
  padding: 14px;
  background: black;
  color: white;
  border: none;
  cursor: pointer;
  font-weight: bold;
  font-size: 15px;
  text-transform: uppercase;
  border-radius: 4px;
  margin-top: 15px;
}

.quick-view-add:disabled {
  background: #aaa;
  cursor: not-allowed;
}

.bonus-message {
  margin: 10px 0;
  font-size: 14px;
  color: green;
  font-weight: bold;
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const modal = document.getElementById("quick-view-modal");
  const closeBtn = modal.querySelector(".quick-view-close");
  const addBtn = document.getElementById("quick-view-add");
  const bonusMessage = document.getElementById("bonus-message");
  let currentProduct = null;
  let selectedVariant = null;

  // ✅ Trigger Quick View
  document.querySelectorAll(".quick-view-trigger").forEach(btn => {
    btn.addEventListener("click", function () {
      const handle = this.dataset.handle;

      fetch(`/products/${handle}.js`)
        .then(res => res.json())
        .then(product => {
          currentProduct = product;

          document.getElementById("quick-view-title").innerText = product.title;
          document.getElementById("quick-view-price").innerText =
            (product.price / 100).toFixed(2) + " " + Shopify.currency.active;
          document.getElementById("quick-view-description").innerText = product.description;
          document.getElementById("quick-view-image").src = product.images[0];

          const optionsContainer = document.getElementById("quick-view-options");
          optionsContainer.innerHTML = "";

          product.options.forEach((option, index) => {
            const div = document.createElement("div");
            div.className = "quick-view-option";

            const label = document.createElement("label");
            label.innerText = option.name;
            div.appendChild(label);

            const select = document.createElement("select");
            option.values.forEach(value => {
              const opt = document.createElement("option");
              opt.value = value;
              opt.innerText = value;
              select.appendChild(opt);
            });

            select.addEventListener("change", () => {
              updateVariant();
            });

            div.appendChild(select);
            optionsContainer.appendChild(div);
          });

          updateVariant(); // initialize
          modal.style.display = "flex";
        });
    });
  });

  // ✅ Close modal
  closeBtn.addEventListener("click", () => {
    modal.style.display = "none";
  });

  // ✅ Update variant when options change
  function updateVariant() {
    const selectedOptions = Array.from(
      modal.querySelectorAll(".quick-view-option select")
    ).map(select => select.value);

    selectedVariant = currentProduct.variants.find(v => {
      return v.options.every((opt, i) => opt === selectedOptions[i]);
    });

    if (selectedVariant) {
      addBtn.disabled = false;
      addBtn.dataset.variantId = selectedVariant.id;
      addBtn.dataset.selectedOptions = JSON.stringify(selectedOptions);

      // 🎁 Show bonus message if Black + M
      if (selectedOptions.includes("Black") && selectedOptions.includes("M")) {
        bonusMessage.style.display = "block";
      } else {
        bonusMessage.style.display = "none";
      }

    } else {
      addBtn.disabled = true;
      bonusMessage.style.display = "none";
    }
  }

  // ✅ Add to cart (with bonus product logic)
  addBtn.addEventListener("click", () => {
    if (!selectedVariant) return;

    const selectedOptions = JSON.parse(addBtn.dataset.selectedOptions || "[]");

    let itemsToAdd = [
      {
        id: selectedVariant.id,
        quantity: 1
      }
    ];

    // 🎁 Check bonus condition: Black + Medium
    if (selectedOptions.includes("Black") && selectedOptions.includes("M")) {
      fetch("/products/soft-winter-jacket.js")
        .then(res => res.json())
        .then(bonusProduct => {
          const bonusVariant = bonusProduct.variants[0]; // first variant
          itemsToAdd.push({
            id: bonusVariant.id,
            quantity: 1
          });
          addItemsToCart(itemsToAdd);
        });
    } else {
      addItemsToCart(itemsToAdd);
    }
  });

  function addItemsToCart(items) {
    fetch("/cart/add.js", {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({ items })
    })
    .then(res => res.json())
    .then(() => {
      window.location.href = "/cart"; // redirect to cart
    });
  }
});
</script>
