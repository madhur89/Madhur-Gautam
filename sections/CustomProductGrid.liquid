{% comment %}
Quick View Product Grid with Popup
- Shows products from a selected collection
- Hover "+" opens modal styled like luxury store
- Color = swatches, Size = dropdown
- Add to cart + optional bonus product (Black + M → Soft Winter Jacket)
{% endcomment %}

<div class="product-grid">
  {% for product in collections[section.settings.collection].products limit: section.settings.limit %}
    <div class="product-card">
      <div class="product-image-wrapper">
        <img src="{{ product.featured_image | img_url: '400x' }}" alt="{{ product.title }}" class="product-img"/>
        <button class="quick-view-trigger" data-handle="{{ product.handle }}">+</button>
      </div>
      <h3 class="product-title">{{ product.title }}</h3>
      <p class="product-price">{{ product.price | money }}</p>
    </div>
  {% endfor %}
</div>

<!-- ✅ Quick View Modal -->
<div id="quick-view-modal" class="quick-view-modal">
  <div class="quick-view-content">
    <button class="quick-view-close">&times;</button>
    
    <div class="quick-view-header">
      <img id="quick-view-image" src="" alt="" class="quick-view-image"/>
      <div class="quick-view-info">
        <h2 id="quick-view-title"></h2>
        <p id="quick-view-price"></p>
        <p id="quick-view-description"></p>
      </div>
    </div>

    <div id="quick-view-options" class="quick-view-options"></div>

    <p id="bonus-message" class="bonus-message" style="display:none;">
      🎁 Bonus: <strong>{{ section.settings.bonus_product_title }}</strong> will be added automatically
    </p>

    <button id="quick-view-add" class="quick-view-add" disabled>
      ADD TO CART →
    </button>
  </div>
</div>

<style>
/* ✅ Grid Layout */
.product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin: 40px 10px;
}

.product-card {
    background: #fff;
    border-radius: 0px;
    overflow: hidden;
    position: relative;
    text-align: center;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.product-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 6px 18px rgba(0,0,0,0.08);
}
.product-image-wrapper {
  position: relative;
}
.product-img {
  width: 100%;
  display: block;
  border-radius: 0px;
}
.quick-view-trigger {
    position: absolute;
    top: 55%;
    right: 38%;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #ffffff;
    color: #000000;
    border: none;
    cursor: pointer;
    font-size: 20px;
    font-weight: normal;
    display: flex;
    align-items: center;
    justify-content: center;
}
.product-title {
  margin: 10px 0 5px;
  font-size: 16px;
  font-weight: 600;
}
.product-price {
  font-size: 14px;
  color: #666;
  margin-bottom: 10px;
}

/* ✅ Tablet: still 3 per row but tighter spacing */
@media (max-width: 1024px) {
  .product-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
  }
}

/* ✅ Mobile: 2 per row */
@media (max-width: 768px) {
  .product-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
  }
}

/* ✅ Modal */
.quick-view-modal {
  display: none;
  position: fixed;
  z-index: 9999;
  left: 0; top: 0;
  width: 100%; height: 100%;
  background: rgba(0,0,0,0.6);
  justify-content: center;
  align-items: center;
  padding: 15px;
}
.quick-view-content {
  background: #fff;
  padding: 20px;
  max-width: 440px;
  width: 100%;
  border-radius: 0px;
  position: relative;
  
}
.quick-view-close {
  position: absolute;
  right: 15px; top: 15px;
  border: none;
  background: none;
  font-size: 24px;
  cursor: pointer;
}
.quick-view-header {
  display: flex;
  gap: 15px;
  align-items: flex-start;
  margin-bottom: 15px;
}
.quick-view-image {
  width: 150px;
  height: auto;
  border-radius: 0px;
}
.quick-view-info h2 {
  margin: 0;
  font-size: 18px;
}
.quick-view-info p {
  margin: 5px 0;
  font-size: 14px;
  color: #444;
}

/* ✅ Options */
.quick-view-option {
  margin-bottom: 12px;
}
.quick-view-option label {
  font-weight: bold;
  font-size: 14px;
  margin-bottom: 5px;
  display: block;
}
.quick-view-option select {
  width: 100%;
  padding: 8px;
  font-size: 14px;
  border: 1px solid #ddd;
  border-radius: 4px;
}

/* ✅ Swatch Style */
.swatch-group {
  display: flex;
  gap: 8px;
  margin-bottom: 12px;
}
.swatch {
  border: 1px solid #aaa;
 padding: 2% 20%;
  cursor: pointer;
  border-radius: 0px;
  font-size: 14px;
  background: white;
  transition: all 0.2s ease;
}
@media only screen and(max-width:768px){
  .swatch{
  padding: 2% 18.5%;}
}
.swatch:hover {
  border-color: black;
}
.swatch.active {
  border: 2px solid black;
  font-weight: bold;
}

/* ✅ Add to Cart */
.quick-view-add {
  width: 100%;
  padding: 14px;
  background: black;
  color: white;
  border: none;
  cursor: pointer;
  font-weight: bold;
  font-size: 15px;
  text-transform: uppercase;
  border-radius: 0px;
  margin-top: 15px;
  transition: background 0.2s ease;
}
.quick-view-add:hover:not(:disabled) {
  background: #333;
}
.quick-view-add:disabled {
  background: #aaa;
  cursor: not-allowed;
}

.bonus-message {
  margin: 10px 0;
  font-size: 14px;
  color: green;
  font-weight: bold;
}
</style>


<script>
document.addEventListener("DOMContentLoaded", function () {
  const modal = document.getElementById("quick-view-modal");
  const closeBtn = modal.querySelector(".quick-view-close");
  const addBtn = document.getElementById("quick-view-add");
  const bonusMessage = document.getElementById("bonus-message");
  let currentProduct = null;
  let selectedVariant = null;

  // ✅ Trigger Quick View
  document.querySelectorAll(".quick-view-trigger").forEach(btn => {
    btn.addEventListener("click", function () {
      const handle = this.dataset.handle;

      fetch(`/products/${handle}.js`)
        .then(res => res.json())
        .then(product => {
          currentProduct = product;

          document.getElementById("quick-view-title").innerText = product.title;
          document.getElementById("quick-view-price").innerText =
            (product.price / 100).toFixed(2) + " " + Shopify.currency.active;
          document.getElementById("quick-view-description").innerHTML = product.description;
          document.getElementById("quick-view-image").src = product.images[0];

          const optionsContainer = document.getElementById("quick-view-options");
          optionsContainer.innerHTML = "";

          product.options.forEach((option, index) => {
            const div = document.createElement("div");
            div.className = "quick-view-option";

            const label = document.createElement("label");
            label.innerText = option.name;
            div.appendChild(label);

            // ✅ If Color → swatches, else dropdown
            if (option.name.toLowerCase().includes("color")) {
              const swatchGroup = document.createElement("div");
              swatchGroup.className = "swatch-group";
              option.values.forEach(value => {
                const swatch = document.createElement("div");
                swatch.className = "swatch";
                swatch.innerText = value;
                swatch.addEventListener("click", () => {
                  swatchGroup.querySelectorAll(".swatch").forEach(s => s.classList.remove("active"));
                  swatch.classList.add("active");
                  swatchGroup.dataset.value = value;
                  updateVariant();
                });
                swatchGroup.appendChild(swatch);
              });
              div.appendChild(swatchGroup);
            } else {
              const select = document.createElement("select");
              option.values.forEach(value => {
                const opt = document.createElement("option");
                opt.value = value;
                opt.innerText = value;
                select.appendChild(opt);
              });
              select.addEventListener("change", () => {
                updateVariant();
              });
              div.appendChild(select);
            }

            optionsContainer.appendChild(div);
          });

          updateVariant(); // initialize
          modal.style.display = "flex";
        });
    });
  });

  // ✅ Close modal
  closeBtn.addEventListener("click", () => {
    modal.style.display = "none";
  });

  // ✅ Update variant
  function updateVariant() {
    const selectedOptions = [];

    document.querySelectorAll(".quick-view-option").forEach(div => {
      const swatchGroup = div.querySelector(".swatch-group");
      if (swatchGroup) {
        selectedOptions.push(swatchGroup.dataset.value || "");
      } else {
        const select = div.querySelector("select");
        selectedOptions.push(select.value);
      }
    });

    selectedVariant = currentProduct.variants.find(v => {
      return v.options.every((opt, i) => opt === selectedOptions[i]);
    });

    if (selectedVariant) {
      addBtn.disabled = false;
      addBtn.dataset.variantId = selectedVariant.id;
      addBtn.dataset.selectedOptions = JSON.stringify(selectedOptions);

      // 🎁 Show bonus message
      if (selectedOptions.includes("Black") && selectedOptions.includes("M")) {
        bonusMessage.style.display = "block";
      } else {
        bonusMessage.style.display = "none";
      }
    } else {
      addBtn.disabled = true;
      bonusMessage.style.display = "none";
    }
  }

  // ✅ Add to cart
  addBtn.addEventListener("click", () => {
    if (!selectedVariant) return;

    const selectedOptions = JSON.parse(addBtn.dataset.selectedOptions || "[]");

    let itemsToAdd = [
      {
        id: selectedVariant.id,
        quantity: 1
      }
    ];

    // 🎁 Bonus product if Black + M
    if (selectedOptions.includes("Black") && selectedOptions.includes("M")) {
      fetch("/products/{{ section.settings.bonus_product_handle }}.js")
        .then(res => res.json())
        .then(bonusProduct => {
          const bonusVariant = bonusProduct.variants[0];
          itemsToAdd.push({
            id: bonusVariant.id,
            quantity: 1
          });
          addItemsToCart(itemsToAdd);
        });
    } else {
      addItemsToCart(itemsToAdd);
    }
  });

  function addItemsToCart(items) {
    fetch("/cart/add.js", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ items })
    })
    .then(res => res.json())
    .then(() => {
      window.location.href = "/cart"; // redirect
    });
  }
});
</script>

{% schema %}
{
  "name": "Quick View grid",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Choose collection"
    },
    {
      "type": "number",
      "id": "limit",
      "label": "Number of products",
      "default": 6
    },
    {
      "type": "text",
      "id": "bonus_product_handle",
      "label": "Bonus product handle",
      "default": "soft-winter-jacket"
    },
    {
      "type": "text",
      "id": "bonus_product_title",
      "label": "Bonus product title",
      "default": "Soft Winter Jacket"
    }
  ],
  "presets": [
    {
      "name": "Quick View Grid"
    }
  ]
}
{% endschema %}
