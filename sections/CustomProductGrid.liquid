{% comment %}
Quick View Product Grid with Popup
- Shows products from a selected collection
- Hover "+" opens modal styled like luxury store
- Color = swatches, Size = dropdown
- Add to cart + optional bonus product (Black + M → Soft Winter Jacket)
{% endcomment %}

<div class="product-grid">
  {% for product in collections[section.settings.collection].products limit: section.settings.limit %}
    <div class="product-card">
      <img src="{{ product.featured_image | img_url: '400x' }}" alt="{{ product.title }}" class="product-img"/>
      <button class="quick-view-trigger" data-handle="{{ product.handle }}">+</button>
    </div>
  {% endfor %}
</div>

<!-- ✅ Quick View Modal -->
<div id="quick-view-modal" class="quick-view-modal">
  <div class="quick-view-content">
    <button class="quick-view-close">&times;</button>
    <div class="quick-view-header">
      <img id="quick-view-image" src="" alt="" class="quick-view-image"/>
      <div class="quick-view-info">
        <h2 id="quick-view-title"></h2>
        <p id="quick-view-price"></p>
        <p id="quick-view-description"></p>
      </div>
    </div>
    <div id="quick-view-options" class="quick-view-options"></div>
    <p id="bonus-message" class="bonus-message" style="display:none;">
      🎁 Bonus: <strong>{{ section.settings.bonus_product_title }}</strong> will be added automatically
    </p>
    <button id="quick-view-add" class="quick-view-add" disabled>
      ADD TO CART →
    </button>
  </div>
</div>

<style>
/* ✅ Grid */

/* Grid layout */
.product-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
  margin: 20px 0;
}

/* Product card */
.product-card {
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  position: relative;
  text-align: center;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.product-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 20px rgba(0,0,0,0.1);
}

/* Image wrapper */
.product-image-wrapper {
  position: relative;
  overflow: hidden;
}

.product-image-wrapper img {
  width: 100%;
  display: block;
  border-radius: 12px;
}

/* Quick view button */
.quick-view-trigger {
  position: absolute;
  top: 10px;
  right: 10px;
  background: black;
  color: white;
  border: none;
  border-radius: 50%;
  width: 32px;
  height: 32px;
  font-size: 20px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s ease;
}

.quick-view-trigger:hover {
  background: #444;
}

/* Product text */
.product-card h3 {
  margin: 10px 0 5px;
  font-size: 16px;
  font-weight: 600;
}

.product-card p {
  font-size: 14px;
  color: #555;
  margin-bottom: 15px;
}

/* ✅ Mobile: force 2 per row */
@media (max-width: 768px) {
  .product-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
  }
}


/* ✅ Modal */
.quick-view-modal {
  display: none;
  position: fixed;
  z-index: 9999;
  left: 0; top: 0;
  width: 100%; height: 100%;
  background: rgba(0,0,0,0.6);
  justify-content: center;
  align-items: center;
  padding: 15px;
}
.quick-view-content {
  background: #fff;
  padding: 20px;
  max-width: 420px;
  width: 100%;
  border-radius: 6px;
  position: relative;
  font-family: Arial, sans-serif;
}
.quick-view-close {
  position: absolute;
  right: 15px; top: 15px;
  border: none;
  background: none;
  font-size: 22px;
  cursor: pointer;
}
.quick-view-header {
  display: flex;
  gap: 15px;
  align-items: flex-start;
  margin-bottom: 15px;
}
.quick-view-image {
  width: 100px;
  height: auto;
  border-radius: 4px;
}
.quick-view-info h2 {
  margin: 0;
  font-size: 18px;
}
.quick-view-info p {
  margin: 5px 0;
  font-size: 14px;
  color: #444;
}

/* ✅ Options */
.quick-view-option {
  margin-bottom: 12px;
}
.quick-view-option label {
  font-weight: bold;
  font-size: 14px;
  margin-bottom: 5px;
  display: block;
}
.quick-view-option select {
  width: 100%;
  padding: 8px;
  font-size: 14px;
  border: 1px solid #ddd;
  border-radius: 4px;
}

/* ✅ Swatch Style */
.swatch-group {
  display: flex;
  gap: 8px;
}
.swatch {
  border: 1px solid #aaa;
  padding: 6px 12px;
  cursor: pointer;
  border-radius: 4px;
  font-size: 14px;
  background: white;
}
.swatch.active {
  border: 2px solid black;
  font-weight: bold;
}

/* ✅ Add to Cart */
.quick-view-add {
  width: 100%;
  padding: 14px;
  background: black;
  color: white;
  border: none;
  cursor: pointer;
  font-weight: bold;
  font-size: 15px;
  text-transform: uppercase;
  border-radius: 4px;
  margin-top: 15px;
}
.quick-view-add:disabled {
  background: #aaa;
  cursor: not-allowed;
}

.bonus-message {
  margin: 10px 0;
  font-size: 14px;
  color: green;
  font-weight: bold;
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const modal = document.getElementById("quick-view-modal");
  const closeBtn = modal.querySelector(".quick-view-close");
  const addBtn = document.getElementById("quick-view-add");
  const bonusMessage = document.getElementById("bonus-message");
  let currentProduct = null;
  let selectedVariant = null;

  // ✅ Trigger Quick View
  document.querySelectorAll(".quick-view-trigger").forEach(btn => {
    btn.addEventListener("click", function () {
      const handle = this.dataset.handle;

      fetch(`/products/${handle}.js`)
        .then(res => res.json())
        .then(product => {
          currentProduct = product;

          document.getElementById("quick-view-title").innerText = product.title;
          document.getElementById("quick-view-price").innerText =
            (product.price / 100).toFixed(2) + " " + Shopify.currency.active;
          document.getElementById("quick-view-description").innerHTML = product.description;
          document.getElementById("quick-view-image").src = product.images[0];

          const optionsContainer = document.getElementById("quick-view-options");
          optionsContainer.innerHTML = "";

          product.options.forEach((option, index) => {
            const div = document.createElement("div");
            div.className = "quick-view-option";

            const label = document.createElement("label");
            label.innerText = option.name;
            div.appendChild(label);

            if (option.name.toLowerCase().includes("color")) {
              const swatchGroup = document.createElement("div");
              swatchGroup.className = "swatch-group";
              option.values.forEach(value => {
                const swatch = document.createElement("div");
                swatch.className = "swatch";
                swatch.innerText = value;
                swatch.addEventListener("click", () => {
                  swatchGroup.querySelectorAll(".swatch").forEach(s => s.classList.remove("active"));
                  swatch.classList.add("active");
                  swatchGroup.dataset.value = value;
                  updateVariant();
                });
                swatchGroup.appendChild(swatch);
              });
              div.appendChild(swatchGroup);
            } else {
              const select = document.createElement("select");
              option.values.forEach(value => {
                const opt = document.createElement("option");
                opt.value = value;
                opt.innerText = value;
                select.appendChild(opt);
              });
              select.addEventListener("change", updateVariant);
              div.appendChild(select);
            }

            optionsContainer.appendChild(div);
          });

          updateVariant();
          modal.style.display = "flex";
        });
    });
  });

  closeBtn.addEventListener("click", () => {
    modal.style.display = "none";
  });

  // ✅ Variant selection logic
  function updateVariant() {
    const selectedOptions = [];

    document.querySelectorAll(".quick-view-option").forEach(div => {
      const swatchGroup = div.querySelector(".swatch-group");
      if (swatchGroup) {
        selectedOptions.push(swatchGroup.dataset.value || "");
      } else {
        const select = div.querySelector("select");
        selectedOptions.push(select.value);
      }
    });

    selectedVariant = currentProduct.variants.find(v =>
      v.options.every((opt, i) => opt === selectedOptions[i])
    );

    if (selectedVariant) {
      addBtn.disabled = false;
      addBtn.dataset.variantId = selectedVariant.id;
      addBtn.dataset.selectedOptions = JSON.stringify(selectedOptions);

      if (selectedOptions.includes("Black") && selectedOptions.includes("M")) {
        bonusMessage.style.display = "block";
      } else {
        bonusMessage.style.display = "none";
      }
    } else {
      addBtn.disabled = true;
      bonusMessage.style.display = "none";
    }
  }

  // ✅ Add to cart (with bonus product if conditions match)
  addBtn.addEventListener("click", async () => {
    if (!selectedVariant) return;

    const selectedOptions = JSON.parse(addBtn.dataset.selectedOptions || "[]");
    let itemsToAdd = [
      { id: selectedVariant.id, quantity: 1 }
    ];

    // 🎁 If Black + M, fetch bonus product
    if (selectedOptions.includes("Black") && selectedOptions.includes("M")) {
      try {
        const res = await fetch("/products/{{ section.settings.bonus_product_handle }}.js");
        const bonusProduct = await res.json();
        if (bonusProduct.variants.length > 0) {
          itemsToAdd.push({ id: bonusProduct.variants[0].id, quantity: 1 });
        }
      } catch (e) {
        console.error("Bonus product fetch failed", e);
      }
    }

    // ✅ Add all items at once
    fetch("/cart/add.js", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ items: itemsToAdd })
    })
    .then(r => r.json())
    .then(() => {
      window.location.href = "/cart";
    })
    .catch(err => console.error("Add to cart failed", err));
  });
});
</script>


{% schema %}
{
  "name": "Quick View grid",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Choose collection"
    },
    {
      "type": "number",
      "id": "limit",
      "label": "Number of products",
      "default": 6
    },
    {
      "type": "text",
      "id": "bonus_product_handle",
      "label": "Bonus product handle",
      "default": "soft-winter-jacket"
    },
    {
      "type": "text",
      "id": "bonus_product_title",
      "label": "Bonus product title",
      "default": "Soft Winter Jacket"
    }
  ],
  "presets": [
    {
      "name": "Quick View Grid"
    }
  ]
}
{% endschema %}
