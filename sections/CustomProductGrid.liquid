{% schema %}
{
  "name": "Product Grid +Quick View",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "default": 6,
      "min": 2,
      "max": 24,
      "step": 1
    },
    {
      "type": "product",
      "id": "bonus_product",
      "label": "Bonus product (auto-add when Black + Medium chosen)",
      "info": "Select “Soft Winter Jacket”."
    }
  ],
  "presets": [
    { "name": "Product Grid • Hotspots + Quick View", "category": "Collection" }
  ]
}
{% endschema %}

{% assign coll = collections[section.settings.collection] %}

<section id="pgqv-{{ section.id }}" class="pgqv" data-section-id="{{ section.id }}"
  data-bonus-handle="{% if section.settings.bonus_product %}{{ all_products[section.settings.bonus_product].handle }}{% endif %}">
  <div class="pgqv-grid">
    {% if coll %}
      {% for product in coll.products limit: section.settings.limit %}
        <article class="pgqv-card">
          <div class="pgqv-imgwrap">
            {% if product.featured_image %}
              <img class="pgqv-img" src="{{ product.featured_image | img_url: '700x' }}" alt="{{ product.title | escape }}">
            {% endif %}
            <button type="button" class="pgqv-hotspot" aria-label="Quick view {{ product.title | escape }}" data-handle="{{ product.handle }}">+</button>
          </div>
          <div class="pgqv-meta">
            <h3 class="pgqv-title">{{ product.title }}</h3>
            <div class="pgqv-price">{{ product.price | money }}</div>
          </div>
        </article>
      {% endfor %}
    {% else %}
      <p style="text-align:center">Choose a collection in this section’s settings.</p>
    {% endif %}
  </div>

  <!-- Quick View Modal (scoped to this section) -->
  <div class="pgqv-modal" id="pgqv-modal-{{ section.id }}" role="dialog" aria-modal="true" aria-labelledby="pgqv-title-{{ section.id }}" hidden>
    <div class="pgqv-dialog">
      <button type="button" class="pgqv-close" aria-label="Close">×</button>
      <div class="pgqv-content">
        <div class="pgqv-media">
          <img id="pgqv-media-img-{{ section.id }}" alt="">
        </div>
        <div class="pgqv-details">
          <h3 class="pgqv-h" id="pgqv-title-{{ section.id }}"></h3>
          <div class="pgqv-p" id="pgqv-price-{{ section.id }}"></div>
          <div class="pgqv-desc" id="pgqv-desc-{{ section.id }}"></div>
          <div id="pgqv-options-{{ section.id }}"></div>
          <button type="button" class="pgqv-add" id="pgqv-add-{{ section.id }}">ADD TO CART</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
/* ---------- GRID ---------- */
.pgqv { padding: 32px 20px; }
.pgqv-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0,1fr));
  gap: 18px;
}
@media (max-width: 768px){
  .pgqv-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
}
.pgqv-card { background:#fff; border:1px solid #eee; }
.pgqv-imgwrap { position:relative; overflow:hidden; }
.pgqv-img { width:100%; display:block; }
.pgqv-hotspot{
  position:absolute; right:10px; top:10px;
  width:32px; height:32px; border-radius:50%;
  background:#000; color:#fff; border:0; cursor:pointer; font-size:18px; line-height:32px;
  display:flex; align-items:center; justify-content:center;
}
.pgqv-meta{ padding:10px; text-align:center; }
.pgqv-title{ font-size:14px; margin:4px 0 2px; }
.pgqv-price{ color:#555; font-size:13px; }

/* ---------- MODAL ---------- */
.pgqv-modal[hidden]{ display:none; }
.pgqv-modal{
  position:fixed; inset:0; background:rgba(0,0,0,.6);
  display:grid; place-items:center; z-index:10000;
}
.pgqv-dialog{
  background:#fff; width:min(640px,92vw); border-radius:6px; position:relative;
  box-shadow:0 10px 30px rgba(0,0,0,.25);
}
.pgqv-close{
  position:absolute; right:12px; top:8px; border:0; background:transparent;
  font-size:24px; cursor:pointer; line-height:1;
}

/* ---------- MODAL CONTENT LAYOUT ---------- */
.pgqv-content{
  display:grid; grid-template-columns:140px 1fr; gap:16px;
  padding:18px;
}
@media (max-width: 520px){
  .pgqv-content{ grid-template-columns:1fr; }
}
.pgqv-media img{
  width:140px; height:auto; display:block; border:1px solid #eee;
}
@media (max-width:520px){ .pgqv-media img{ width:100%; } }

.pgqv-h{ margin:0 0 6px; font-size:20px; font-weight:600; }
.pgqv-p{ font-weight:600; margin-bottom:10px; }
.pgqv-desc{ color:#4b4b4b; font-size:14px; line-height:1.45; margin-bottom:14px; }

/* ---------- COLOR SWATCH SEGMENTED ---------- */
.pgqv-field{ margin:10px 0 12px; }
.pgqv-label{ font-size:13px; letter-spacing:.02em; margin-bottom:6px; }
.pgqv-seg{
  display:flex; border:1px solid #1a1a1a; border-radius:2px; overflow:hidden;
}
.pgqv-seg-btn{
  position:relative; flex:1; padding:12px 14px; font-size:16px;
  background:#fff; border:0; cursor:pointer; text-align:left;
}
.pgqv-seg-btn + .pgqv-seg-btn{ border-left:3px solid #000; } /* divider like screenshot */
.pgqv-seg-btn.is-active::before{
  content:""; position:absolute; left:0; top:0; bottom:0; width:6px; background:#1e40af; /* blue bar */
}

/* ---------- SIZE SELECT (two-cell look) ---------- */
.pgqv-select{
  display:grid; grid-template-columns:1fr 44px; align-items:center;
  border:1px solid #1a1a1a; border-radius:2px; overflow:hidden;
}
.pgqv-select select{
  appearance:none; -webkit-appearance:none; -moz-appearance:none;
  border:0; background:#fff; padding:12px 14px; font-size:16px; width:100%;
}
.pgqv-select .pgqv-caret{
  display:grid; place-items:center; border-left:1px solid #d1d1d1; height:100%;
}
.pgqv-caret::after{ content:"▾"; font-size:16px; }

/* ---------- ADD BUTTON ---------- */
.pgqv-add{
  position:relative; width:100%; padding:14px 56px 14px 18px;
  background:#000; color:#fff; border:0; cursor:pointer; font-weight:600;
  text-transform:uppercase; letter-spacing:.02em; border-radius:2px;
}
.pgqv-add::after{
  content:"→"; position:absolute; right:18px; top:50%; transform:translateY(-50%); font-size:20px;
}
.pgqv-add::before{
  content:""; position:absolute; right:48px; top:50%; transform:translateY(-50%);
  width:28px; height:2px; background:#fff;
}
.pgqv-add[disabled]{ opacity:.5; cursor:not-allowed; }
</style>

<script>
(function(){
  const section = document.getElementById('pgqv-{{ section.id }}');
  if (!section) return;

  const modal     = document.getElementById('pgqv-modal-{{ section.id }}');
  const imgEl     = document.getElementById('pgqv-media-img-{{ section.id }}');
  const titleEl   = document.getElementById('pgqv-title-{{ section.id }}');
  const priceEl   = document.getElementById('pgqv-price-{{ section.id }}');
  const descEl    = document.getElementById('pgqv-desc-{{ section.id }}');
  const optionsEl = document.getElementById('pgqv-options-{{ section.id }}');
  const addBtn    = document.getElementById('pgqv-add-{{ section.id }}');
  const closeBtn  = modal.querySelector('.pgqv-close');

  let productData = null;
  let selected = {};         // { Color: 'Blue', Size: 'Medium' }
  let selectedVariant = null;

  const bonusHandle = section.dataset.bonusHandle || '';

  function formatMoney(cents){
    try { return Shopify.formatMoney(cents, {{ shop.money_format | json }}); }
    catch(e){ return (cents/100).toFixed(2); }
  }

  function uniqueValues(variants, index){
    const set = new Set();
    variants.forEach(v => set.add(v['option'+(index+1)]));
    return Array.from(set);
  }

  function findVariant(product, sel){
    return product.variants.find(v => {
      return product.options.every((name, idx) => !sel[name] || sel[name] === v['option'+(idx+1)]);
    }) || null;
  }

  function toggleAdd(){
    addBtn.disabled = !selectedVariant;
  }

  function renderOptions(product){
    optionsEl.innerHTML = '';
    selected = {};
    selectedVariant = null;

    product.options.forEach((name, idx) => {
      const values = uniqueValues(product.variants, idx);

      // COLOR -> segmented
      if (/color/i.test(name)) {
        const wrap = document.createElement('div');
        wrap.className = 'pgqv-field';
        wrap.innerHTML = `<div class="pgqv-label">Color</div>`;
        const seg = document.createElement('div'); seg.className = 'pgqv-seg';

        values.forEach((val, i) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'pgqv-seg-btn' + (i===0 ? ' is-active' : '');
          btn.textContent = val;
          btn.addEventListener('click', () => {
            Array.from(seg.children).forEach(c => c.classList.remove('is-active'));
            btn.classList.add('is-active');
            selected[name] = val;
            selectedVariant = findVariant(product, selected);
            if (selectedVariant) priceEl.textContent = formatMoney(selectedVariant.price);
            toggleAdd();
          });
          if (i===0) { selected[name] = val; } // default first color
          seg.appendChild(btn);
        });

        wrap.appendChild(seg);
        optionsEl.appendChild(wrap);
      } else {
        // other options -> stylized select (Size)
        const wrap = document.createElement('div');
        wrap.className = 'pgqv-field';
        wrap.innerHTML = `<div class="pgqv-label">${name}</div>`;
        const selWrap = document.createElement('div'); selWrap.className = 'pgqv-select';
        const select = document.createElement('select');
        const ph = document.createElement('option');
        ph.value = ''; ph.disabled = true; ph.selected = true;
        ph.textContent = /size/i.test(name) ? 'Choose your size' : 'Choose an option';
        select.appendChild(ph);
        values.forEach(val => {
          const opt = document.createElement('option'); opt.value = val; opt.textContent = val;
          select.appendChild(opt);
        });
        select.addEventListener('change', () => {
          if (select.value) selected[name] = select.value;
          selectedVariant = findVariant(product, selected);
          if (selectedVariant) priceEl.textContent = formatMoney(selectedVariant.price);
          toggleAdd();
        });
        const caret = document.createElement('div'); caret.className = 'pgqv-caret';
        selWrap.appendChild(select); selWrap.appendChild(caret);
        wrap.appendChild(selWrap);
        optionsEl.appendChild(wrap);
      }
    });

    // initialize with first color preselected
    selectedVariant = findVariant(product, selected);
    if (selectedVariant) priceEl.textContent = formatMoney(selectedVariant.price);
    toggleAdd();
  }

  function openModal(product){
    productData = product;
    imgEl.src = product.images?.[0] || '';
    imgEl.alt = product.title || '';
    titleEl.textContent = product.title || '';
    priceEl.textContent = formatMoney(product.price);
    descEl.innerHTML = product.description || '';
    renderOptions(product);
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
  }

  function closeModal(){
    modal.hidden = true;
    document.body.style.overflow = '';
  }

  /* --- Event delegation for hotspots (works after theme editor reloads too) --- */
  section.addEventListener('click', (e) => {
    const btn = e.target.closest('.pgqv-hotspot');
    if (!btn) return;
    const handle = btn.getAttribute('data-handle');
    fetch(`/products/${handle}.js`)
      .then(r => r.json())
      .then(openModal)
      .catch(()=>{});
  });

  /* Close modal (overlay click or X) */
  modal.addEventListener('click', (e) => {
    if (e.target === modal || e.target.classList.contains('pgqv-close')) closeModal();
  });

  /* Add to cart + bonus rule + redirect */
  addBtn.addEventListener('click', () => {
    if (!productData) return;
    if (!selectedVariant) selectedVariant = productData.variants[0];

    const mainAdd = fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: selectedVariant.id, quantity: 1 })
    });

    // Black + Medium => also add bonus product (first variant)
    const picked = Object.values(selected).map(v => (v || '').toString().toLowerCase());
    const needBonus = picked.includes('black') && picked.includes('medium');

    let bonusAdd = Promise.resolve();
    if (needBonus && bonusHandle){
      bonusAdd = fetch(`/products/${bonusHandle}.js`)
        .then(r => r.json())
        .then(bp => fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: bp.variants[0].id, quantity: 1 })
        }))
        .catch(()=>{});
    }

    Promise.all([mainAdd, bonusAdd]).then(() => {
      window.location.href = '/cart';
    });
  });

  /* Ensure it also works inside Theme Editor live reloads */
  document.addEventListener('shopify:section:load', (e) => {
    if (e.detail?.sectionId === '{{ section.id }}') {
      // nothing extra required; delegation already bound to the section root
    }
  });
})();
</script>
