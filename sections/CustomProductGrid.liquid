{% comment %}
Quick View Product Grid with Popup
- Shows products from a selected collection
- Hover "+" opens modal styled like luxury store
- Color = swatches, Size = dropdown
- Add to cart + optional bonus product (Black + M → Soft Winter Jacket)
{% endcomment %}

<div class="product-grid">
  {% for product in collections[section.settings.collection].products limit: section.settings.limit %}
    <div class="product-card">
      <img src="{{ product.featured_image | img_url: '400x' }}" alt="{{ product.title }}" class="product-img"/>
      <button class="quick-view-trigger" data-handle="{{ product.handle }}">+</button>
    </div>
  {% endfor %}
</div>

<!-- ✅ Quick View Modal -->
<div id="quick-view-modal" class="quick-view-modal">
  <div class="quick-view-content">
    <button class="quick-view-close">&times;</button>
    <div class="quick-view-header">
      <img id="quick-view-image" src="" alt="" class="quick-view-image"/>
      <div class="quick-view-info">
        <h2 id="quick-view-title"></h2>
        <p id="quick-view-price"></p>
        <p id="quick-view-description"></p>
      </div>
    </div>
    <div id="quick-view-options" class="quick-view-options"></div>
    <p id="bonus-message" class="bonus-message" style="display:none;">
      🎁 Bonus: <strong>{{ section.settings.bonus_product_title }}</strong> will be added automatically
    </p>
    <button id="quick-view-add" class="quick-view-add" disabled>
      ADD TO CART →
    </button>
  </div>
</div>

<style>
/* ✅ Grid */
.product-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
}
.product-card {
  position: relative;
}
.product-img {
  width: 250px;
  border-radius: 6px;
}
.quick-view-trigger {
  position: absolute;
  top: 10px; right: 10px;
  width: 28px; height: 28px;
  border-radius: 50%;
  background: black;
  color: white;
  border: none;
  cursor: pointer;
  font-size: 18px;
  font-weight: bold;
}

/* ✅ Modal */
.quick-view-modal {
  display: none;
  position: fixed;
  z-index: 9999;
  left: 0; top: 0;
  width: 100%; height: 100%;
  background: rgba(0,0,0,0.6);
  justify-content: center;
  align-items: center;
  padding: 15px;
}
.quick-view-content {
  background: #fff;
  padding: 20px;
  max-width: 420px;
  width: 100%;
  border-radius: 6px;
  position: relative;
  font-family: Arial, sans-serif;
}
.quick-view-close {
  position: absolute;
  right: 15px; top: 15px;
  border: none;
  background: none;
  font-size: 22px;
  cursor: pointer;
}
.quick-view-header {
  display: flex;
  gap: 15px;
  align-items: flex-start;
  margin-bottom: 15px;
}
.quick-view-image {
  width: 100px;
  height: auto;
  border-radius: 4px;
}
.quick-view-info h2 {
  margin: 0;
  font-size: 18px;
}
.quick-view-info p {
  margin: 5px 0;
  font-size: 14px;
  color: #444;
}

/* ✅ Options */
.quick-view-option {
  margin-bottom: 12px;
}
.quick-view-option label {
  font-weight: bold;
  font-size: 14px;
  margin-bottom: 5px;
  display: block;
}
.quick-view-option select {
  width: 100%;
  padding: 8px;
  font-size: 14px;
  border: 1px solid #ddd;
  border-radius: 4px;
}

/* ✅ Swatch Style */
.swatch-group {
  display: flex;
  gap: 8px;
}
.swatch {
  border: 1px solid #aaa;
  padding: 6px 12px;
  cursor: pointer;
  border-radius: 4px;
  font-size: 14px;
  background: white;
}
.swatch.active {
  border: 2px solid black;
  font-weight: bold;
}

/* ✅ Add to Cart */
.quick-view-add {
  width: 100%;
  padding: 14px;
  background: black;
  color: white;
  border: none;
  cursor: pointer;
  font-weight: bold;
  font-size: 15px;
  text-transform: uppercase;
  border-radius: 4px;
  margin-top: 15px;
}
.quick-view-add:disabled {
  background: #aaa;
  cursor: not-allowed;
}

.bonus-message {
  margin: 10px 0;
  font-size: 14px;
  color: green;
  font-weight: bold;
}
</style>



{% schema %}
{
  "name": "Quick View grid",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Choose collection"
    },
    {
      "type": "number",
      "id": "limit",
      "label": "Number of products",
      "default": 6
    },
    {
      "type": "text",
      "id": "bonus_product_handle",
      "label": "Bonus product handle",
      "default": "soft-winter-jacket"
    },
    {
      "type": "text",
      "id": "bonus_product_title",
      "label": "Bonus product title",
      "default": "Soft Winter Jacket"
    }
  ],
  "presets": [
    {
      "name": "Quick View Grid"
    }
  ]
}
{% endschema %}
