{% schema %}
{
  "name": "Custom Navbar",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Fallback Logo Text",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "mid_text",
      "label": "Middle Text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "CHOOSE GIFT →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Custom Navbar",
      "category": "Header"
    }
  ]
}
{% endschema %}

<nav class="custom-navbar">
  <div class="navbar-container">
    <div class="navbar-logo">
      {% if section.settings.logo != blank %}
        <img src="{{ section.settings.logo | img_url: '200x' }}" alt="Logo">
      {% else %}
        <span class="logo-text">{{ section.settings.logo_text }}</span>
      {% endif %}
    </div>

    <div class="navbar-mid">
      <p>{{ section.settings.mid_text }}</p>
    </div>

    <div class="navbar-btn">
      <a href="{{ section.settings.button_link }}" class="cta-btn">
        <span>{{ section.settings.button_label }}</span>
      </a>
    </div>
  </div>
</nav>

<style>
.custom-navbar {
  width: 100%;
  background: #f7f7f7;
  padding: 12px 20px;
}

.navbar-container {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
}

.navbar-logo img {
  max-height: 40px;
}

.logo-text {
  font-size: 1.2rem;
  font-weight: bold;
}

.navbar-mid {
  flex: 1;
  text-align: center;
}

.navbar-mid p {
  margin: 0;
  font-size: 1rem;
}

.navbar-btn .cta-btn {
  position: relative;
  display: inline-block;
  padding: 12px 24px;
  background: #ffeb3b;
  color: #000;
  font-weight: bold;
  text-decoration: none;
  border-radius: 6px;
  overflow: hidden;
  transition: color 0.3s ease;
}

.cta-btn span {
  position: relative;
  z-index: 2;
}

.cta-btn::before {
  content: \"\";
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: #000;
  transition: left 0.4s ease;
  z-index: 1;
}

.cta-btn:hover::before {
  left: 0;
}

.cta-btn:hover span {
  color: #fff;
}

/* Responsive */
@media (max-width: 768px) {
  .navbar-container {
    flex-direction: column;
    text-align: center;
    gap: 12px;
  }
}
</style>
